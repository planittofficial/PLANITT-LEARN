# =============================================================================
# Planitt Learn — local development (.env.local)
# =============================================================================
# Everyone on the team uses the same setup:
#   cp .env.example .env.local
#   npm install && npm run dev
#
# Local dev runs without Planitt appbackend (LEARN_DEV_STANDALONE).
# You build ALL features here — courses, videos, quizzes, admin, leaderboard.
#
# Only production/staging deploy secrets need APPBACKEND_URL — not local dev.
# See docs/ENV_REFERENCE.md and docs/LMS_ARCHITECTURE.md
# =============================================================================

# --- Local dev auth & enrollment (required for local) ---
LEARN_DEV_STANDALONE=true
NEXT_PUBLIC_LEARN_DEV_STANDALONE=true

LEARN_DEV_MOCK_USER_ID=dev-local-001
LEARN_DEV_MOCK_USER_NAME=Local Dev
LEARN_DEV_MOCK_USER_EMAIL=dev@localhost.dev
# Optional dev password for email/password sign-in (default: learn123)
# LEARN_DEV_MOCK_PASSWORD=learn123

# Comma-separated course plan IDs — use combo to unlock all courses locally
LEARN_DEV_MOCK_ENROLLMENTS=learn-all-courses-combo

NEXT_PUBLIC_MAIN_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_LEARN_PORTAL_URL=http://localhost:3001

# --- Planitt main website integration (use when wiring staging/production) ---
# Same Google OAuth web client ID as the main Planitt website.
# Add both origins to Google Cloud Console authorized JavaScript origins:
#   http://localhost:3000  (main site)
#   http://localhost:3001  (Learn portal)
# Production example:
#   https://planitt.in
#   https://learn.planitt.in
#
# LEARN_DEV_STANDALONE=false
# APPBACKEND_URL=https://appbackend.planitt.in
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=<same-as-main-website>
# NEXT_PUBLIC_MAIN_WEBSITE_URL=https://planitt.in
# NEXT_PUBLIC_LEARN_PORTAL_URL=https://learn.planitt.in
#
# Main site redirect after checkout (example):
#   window.location.href = `${LEARN_PORTAL_URL}/login?next=/courses/${planId}`

# --- Phase 1: Learn PostgreSQL (Supabase / local Docker) ---
# If password contains @, encode it as %40 in the URL.
# Supabase — use the **Session pooler** URI from Dashboard → Settings → Database.
# Direct `db.<ref>.supabase.co` is often IPv6-only and fails on some Windows networks.
# Example (replace region + password):
# DATABASE_URL=postgresql://postgres.vxmqyyuvvnbqmeuqgdjs:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct connection (only if IPv6 works on your network):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require
#
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/planitt_learn_dev
# LEARN_ADMIN_EMAILS=dev@localhost.dev
# LEARN_ENROLLMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Phase 2: Video storage (Cloudflare R2 or S3) ---
# LEARN_R2_ACCOUNT_ID=
# LEARN_R2_BUCKET=planitt-learn-videos
# LEARN_R2_PUBLIC_URL=https://videos.learn.planitt.in
# R2_ACCESS_KEY_ID=   (for signed uploads — future)
# R2_SECRET_ACCESS_KEY=

# --- Optional: real Planitt integration (staging only — mentor provides) ---
# Flip LEARN_DEV_STANDALONE=false and set the vars in the block above.
# Leave unset for normal local work. Never use production URLs here.
#
# APPBACKEND_URL=https://staging-appbackend.example.com
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-staging-google-client-id

# =============================================================================
# Production deploy (CI/hosting secrets — NOT for .env.local)
# =============================================================================
# DATABASE_URL=<prod-learn-db>
# APPBACKEND_URL=<prod-appbackend>
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=<prod-google-client>
# LEARN_DEV_STANDALONE must be false or unset in production
